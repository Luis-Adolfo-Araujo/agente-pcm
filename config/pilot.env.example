# Copie apenas para o ambiente de execução. Não versione o arquivo preenchido.
MAIA_PILOT_PASSWORD=defina-uma-senha-forte
MAIA_PILOT_ALIAS_SALT=defina-um-segredo-aleatorio-para-os-aliases

# Dados operacionais permanecem fora do repositório.
MAIA_PILOT_SNAPSHOT_DIR=var/pilot/snapshots
MAIA_PILOT_RUN_DIR=var/pilot/runs
MAIA_PILOT_DB=var/pilot/pilot.sqlite3
MAIA_PILOT_TENANT_LABEL=Planta Modelo

# Defaults seguros: pseudônimos visíveis e autenticação obrigatória.
MAIA_PILOT_SHOW_RAW_WORKER_IDS=false
MAIA_PILOT_ALLOW_ANONYMOUS=false
